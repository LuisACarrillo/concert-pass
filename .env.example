# Copia este archivo a .env y llena los valores. .env NO se versiona.
# Para usarlo en los scripts:  set -a; source .env; set +a

# --- AWS ---
AWS_REGION=us-east-1
# Credenciales para los contenedores locales (en AWS Academy incluye el session token)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# --- RDS PostgreSQL (scripts/init.sh y servicios) ---
DB_INSTANCE_IDENTIFIER=ticket-rds-db
# DB_HOST lo imprime scripts/init.sh al terminar
DB_HOST=
DB_PORT=5432
DB_NAME=ticketdb
DB_USER=postgres
# DB_PASSWORD es obligatorio para scripts/init.sh
DB_PASSWORD=

# --- Recursos que se agregan en los siguientes pasos (nombres provisionales) ---
DB_SECRET_NAME=concert-pass/rds
DYNAMODB_TABLE=ticket-reservations
SQS_QUEUE_NAME=ticket-queue.fifo
# SQS_QUEUE_URL lo imprimirá scripts/init.sh cuando se cree la cola
SQS_QUEUE_URL=
