# Referencia de variables. scripts/setup.sh genera el .env real (no se versiona).
# Los scripts cargan .env solos; las variables exportadas en la terminal tienen prioridad.

# --- AWS ---
AWS_REGION=us-east-1
# Credenciales para los contenedores locales (en AWS Academy incluye el session token)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# --- RDS PostgreSQL ---
DB_INSTANCE_IDENTIFIER=ticket-rds-db
# DB_HOST lo obtiene scripts/setup.sh de la RDS
DB_HOST=
DB_PORT=5432
DB_NAME=ticketdb
DB_USER=postgres
# DB_PASSWORD es obligatorio para setup.sh (lo eliges tú)
DB_PASSWORD=

# --- DynamoDB, SQS y Secrets Manager ---
DYNAMODB_TABLE=concertpass-events
SQS_QUEUE_NAME=concertpass-reservations.fifo
# SQS_QUEUE_URL lo imprime scripts/setup-sqs.sh (setup.sh lo escribe en .env)
SQS_QUEUE_URL=
DB_SECRET_NAME=concertpass/rds

# --- Servicios (opcionales; docker-compose.yml y k8s los definen) ---
# URL base de ticket-checkout que usa ticket-worker (le agrega /checkout)
CHECKOUT_URL=http://ticket-checkout:8000
# Conexiones máximas a RDS por réplica de ticket-api
DB_POOL_MAX=10
# ticket-worker
SQS_WAIT_SECONDS=20
SQS_VISIBILITY_TIMEOUT=120
CHECKOUT_TIMEOUT_SECONDS=5
CHECKOUT_RETRIES=3
HEALTH_PORT=8081
HEALTH_MAX_AGE_SECONDS=120
# ticket-checkout: latencia simulada del pago
CHECKOUT_DELAY_MS=0
